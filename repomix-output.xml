                    ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/50 shadow-[0_0_10px_rgba(34,211,238,0.2)]'
                    : 'bg-blue-950 text-white font-extrabold shadow-sm'
                  : isDark
                  ? 'text-slate-400 hover:text-white hover:bg-white/5'
