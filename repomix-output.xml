          author: 'Диспетчер',
        },
      ],
    };

    const newOpenTickets = db.open_tickets.map((t) =>
      t.ticket_id === selectedTicket.ticket_id ? completedTicket : t
    );
    onUpdateDb({ ...db, open_tickets: newOpenTickets });
    setSelectedTicket(null);
  };

  return (
