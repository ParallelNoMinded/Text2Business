              className={`uppercase font-mono text-[10px] tracking-wider border-b ${
                isDark
                  ? 'bg-[#020204] text-cyan-400 border-cyan-500/20'
                  : 'bg-slate-100 text-cyan-800 border-slate-200'
              }`}
            >
              <tr>
                <th className="py-3 px-4">Тарифный План</th>
