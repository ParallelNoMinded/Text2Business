  | 'UPDATE_TICKET'
  | 'REQUEST_CLARIFICATION'
  | 'ESCALATE_TO_HUMAN'
  | 'REJECT';

export type ResultStatus = 'AUTO_APPROVED' | 'REQUIRES_HUMAN_CONFIRMATION' | 'BLOCKED';

