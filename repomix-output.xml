@layer utilities {
  .glass-card-dark {
    background: rgba(10, 10, 20, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(34, 211, 238, 0.18);
  }

  .glass-card-light {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(12px);
