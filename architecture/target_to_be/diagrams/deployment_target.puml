@startuml deployment_target
!include <C4/C4_Deployment.puml>
LAYOUT_TOP_DOWN()

title Deployment — Развертывание в Kubernetes Cluster (To-Be)

Deployment_Node(clients, "Внешний контур", "Клиенты и Операторы") {
  Container(browser_ui, "React Operator Workbench", "React 19 SPA", "Интерфейс HITL")
  Container(tg_cloud, "Telegram App", "iOS / Android", "Мессенджер")
  Container(sip_caller, "IP Телефония / PBX", "SIP Stream", "Голосовые вызовы")
}

Deployment_Node(k8s_cluster, "Enterprise Kubernetes Cluster", "Production K8s High Availability") {
  Deployment_Node(ingress_ns, "Namespace: ingress-layer", "Ingress") {
    Container(envoy_pods, "Envoy Gateway Pods", "Envoy / C++", "TLS 1.3 Termination, Rate Limiting")
  }
  Deployment_Node(event_ns, "Namespace: event-streaming", "Kafka Strimzi") {
    ContainerDb(kafka_cluster, "Kafka Brokers Cluster", "Apache Kafka", "Шина событий")
  }
  Deployment_Node(services_ns, "Namespace: core-services", "Microservices") {
    Container(stt_pods, "STT Service Pods", "Go / Yandex SpeechKit", "Транскрипция речи")
    Container(ai_pods, "AI Perception Pods (GPU)", "Python / LangGraph", "Мультиагентный аналитик")
    Container(temporal_pods, "Temporal.io Cluster Pods", "Temporal Server", "Оркестрация Workflows")
    Container(core_worker_pods, "Core Decision Workers", "Go Temporal Workers", "Детерминированные правила")
    Container(adapter_1c_pods, "1C OData Adapter Pods", "Go Service", "Синхронизация с 1С")
  }
  Deployment_Node(db_ns, "Namespace: database-layer", "HA Storage") {
    ContainerDb(postgres_ha, "PostgreSQL 18 HA Cluster", "Patroni / PgBouncer", "Тикеты и pgvector эмбеддинги")
  }
  Deployment_Node(obs_ns, "Namespace: observability", "Telemetry") {
    Container(otel_pods, "OpenTelemetry Collector Pods", "OTel DaemonSet", "Сбор телеметрии")
  }
}

Deployment_Node(ext_saas, "Внешние SaaS Системы", "Cloud") {
  System_Ext(yandex_stt, "Yandex SpeechKit v3", "gRPC Cloud STT")
  System_Ext(llm_cloud, "GitHub Models / vLLM", "LLM APIs")
  System_Ext(1c_server, "1С:ERP Предприятие", "1C OData Server")
  System_Ext(arize_cloud, "Arize AI Cloud", "Observability SaaS")
}

Rel(browser_ui, envoy_pods, "HTTPS / WSS", "TLS 1.3")
Rel(tg_cloud, envoy_pods, "Telegram Webhooks", "HTTPS")
Rel(sip_caller, envoy_pods, "Голосовой поток", "gRPC")
Rel(envoy_pods, kafka_cluster, "Публикация событий", "Kafka Protocol")
Rel(kafka_cluster, stt_pods, "Чтение аудио событий", "Kafka Consumer")
Rel(stt_pods, yandex_stt, "Потоковая транскрипция", "gRPC Streaming")
Rel(kafka_cluster, ai_pods, "Чтение текста", "Kafka Consumer")
Rel(ai_pods, llm_cloud, "Запрос к LLM", "HTTPS")
Rel(ai_pods, postgres_ha, "RAG векторный поиск", "pgvector")
Rel(kafka_cluster, core_worker_pods, "Чтение фактов", "Kafka Consumer")
Rel(core_worker_pods, temporal_pods, "Регистрация Workflows", "gRPC")
Rel(core_worker_pods, postgres_ha, "Сохранение состояния", "SQL")
Rel(core_worker_pods, adapter_1c_pods, "Вызов проведения", "gRPC")
Rel(adapter_1c_pods, 1c_server, "Проведение ЗаявкиНаРемонт", "OData REST")
Rel(ai_pods, otel_pods, "Отправка спанов", "OTLP gRPC")
Rel(core_worker_pods, otel_pods, "Отправка спанов", "OTLP gRPC")
Rel(otel_pods, arize_cloud, "Экспорт телеметрии", "OTLP")

SHOW_LEGEND()
@endl