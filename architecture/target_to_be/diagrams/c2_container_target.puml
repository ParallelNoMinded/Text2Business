@startuml c2_container_target
!include <C4/C4_Container.puml>
LAYOUT_TOP_DOWN()

title C2 — Container: Text2Business Enterprise (Целевое состояние / To-Be)

Person(client, "B2B Заявитель", "Мультимедийные каналы")
Person(operator, "Диспетчер (HITL)", "Оператор системы")

System_Boundary(target_system, "Text2Business Event-Driven Platform") {
  Container(envoy_gateway, "Ingress Gateway", "Envoy Gateway", "TLS 1.3 Termination, Rate Limiting, Webhook Ingress")
  ContainerDb(kafka_bus, "Kafka Event Bus", "Apache Kafka", "Шина событий: InboundMessages, FactsExtracted")
  Container(stt_service, "Service 1: STT Service", "Go / Yandex SpeechKit", "Потоковая транскрипция аудио")
  Container(ai_service, "Service 2: AI Engine", "Python / LangGraph", "Извлечение фактов, RAG векторный поиск")
  Container(core_engine, "Service 3: Decision Engine", "Go / Temporal.io Worker", "Оркестрация процессов, HITL паузы, расчет SLA")
  Container(adapter_1c, "Service 4: 1C Adapter", "Go Service", "Адаптер OData REST для 1С")
  ContainerDb(postgres_db, "Data Store & Vector DB", "PostgreSQL 18 + pgvector", "Тикеты, эмбеддинги RAG")
  Container(otel_agent, "OpenTelemetry Collector", "OTel Collector", "Сбор метрик и трейсов")
  Container(operator_ui, "React HITL Workbench", "React 19 SPA", "Интерфейс диспетчера")
}

System_Ext(ai_cloud, "LLM Inference API", "GitHub Models / vLLM")
System_Ext(erp_1c, "1С:ERP Предприятие", "1C OData REST")
System_Ext(arize_cloud, "Arize AI Cloud", "Observability SaaS")

Rel(client, envoy_gateway, "Входящие вызовы", "HTTPS / SIP")
Rel(envoy_gateway, kafka_bus, "Публикация InboundMessageReceived", "Kafka Protocol")
Rel(kafka_bus, stt_service, "Подписка на аудиопотоки", "Kafka Consumer")
Rel(stt_service, kafka_bus, "Публикация SpeechTranscribed", "Kafka Producer")
Rel(kafka_bus, ai_service, "Подписка на текст", "Kafka Consumer")
Rel(ai_service, ai_cloud, "Извлечение фактов", "HTTPS / gRPC")
Rel(ai_service, postgres_db, "RAG векторный поиск", "pgvector")
Rel(ai_service, kafka_bus, "Публикация FactsExtracted", "Kafka Producer")
Rel(kafka_bus, core_engine, "Подписка на факты", "Kafka Consumer")
Rel(core_engine, postgres_db, "Сохранение состояния Temporal", "SQL")
Rel(core_engine, operator_ui, "Уведомление HITL", "WebSocket")
Rel(operator_ui, envoy_gateway, "Утверждение решения", "HTTPS / REST")
Rel(core_engine, adapter_1c, "Запуск проведения в 1С", "gRPC Internal")
Rel(adapter_1c, erp_1c, "Проведение ЗаявкиНаРемонт", "OData REST")
Rel(ai_service, otel_agent, "Отправка спанов", "OTLP gRPC")
Rel(core_engine, otel_agent, "Отправка спанов", "OTLP gRPC")
Rel(otel_agent, arize_cloud, "Экспорт телеметрии", "OTLP")

SHOW_LEGEND()
@enduml