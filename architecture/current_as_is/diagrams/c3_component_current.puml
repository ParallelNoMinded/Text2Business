  Component(guardrail_checker, "Guardrail Inspector", "Function (checkGuardrails)", "Проверка промпт-инъекций и атак")
  Component(site_lookup, "Customer & Site Lookup Tool", "Function (tool_find_customer_or_site)", "Поиск контрагентов и складов")
  Component(asset_disambiguator, "Asset Disambiguator", "Function (tool_find_assets_and_open_tickets)", "Разрешение конфликта ассетов по открытым тикетам")
