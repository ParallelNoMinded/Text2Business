Rel(ingress_router, llm_service, "Извлечение фактов", "Async")
Rel(telegram_poller, llm_service, "Извлечение фактов", "Async")
Rel(llm_service, fallback_extractor, "Переключение при ошибке API", "Fallback")
Rel(ingress_router, decision_matrix, "Запуск диспетчеризации", "Function Call")
Rel(decision_matrix, guardrail_checker, "1. Проверка Guardrails", "In-Process")
Rel(decision_matrix, site_lookup, "2. Поиск контрагента", "In-Process")
Rel(decision_matrix, asset_disambiguator, "3. Поиск ассета и тикетов", "In-Process")
Rel(decision_matrix, sla_calculator, "4. Расчет SLA", "In-Process")
Rel(decision_matrix, db_manager, "5. Сохранение тикетов", "In-Memory")
Rel(odata_adapter, db_manager, "Чтение для 1С", "In-Memory")

