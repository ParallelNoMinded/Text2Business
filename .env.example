# Google Gemini API (primary LLM provider)
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-3.5-flash-lite"

# Security: заголовок X-Dispatch-Token для всех мутирующих эндпоинтов API.
# Если не задан, используется dev-дефолт "dev-dispatch-token" (только для локальной разработки).
DISPATCH_TOKEN="change-me-in-production"

# NVIDIA
NVIDIA_API_KEY="your_token"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="nvidia/nemotron-3-ultra-550b-a55b"

# Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY="your_token"
GOOGLE_MODEL="gemini-3.5-flash-lite"

# Groq
GROQ_API_KEY="your_token"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="qwen/qwen3.6-27b"

# DeepSeek
DEEPSEEK_API_KEY="your_token"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-reasoner"

# Ollama
OLLAMA_BASE_URL="http://host.docker.internal:11434"
OLLAMA_MODEL="gemma4:e4b"
